{
  "name": "volley-vault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Volley Vault - rogue-lite brick volley mobile game (HTML5 + Capacitor)",
  "scripts": {
    "serve": "python3 -m http.server 8080 -d www",
    "sim": "node scripts/sim.mjs 40",
    "android:add": "npx cap add android && npx cap sync android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}